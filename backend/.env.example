# ══════════════════════════════════════════════════════════════════════════════
# Syntaxed-IEGMS — Environment Configuration
# Copy this file to `backend/.env` and fill in your API key.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI Provider Switch ───────────────────────────────────────────────────────
# Options: "gemini" (Google Gen AI SDK / API) or "ollama" (Local/Remote Ollama)
# Change to "ollama" anytime to revert back to Ollama immediately.
AI_PROVIDER=gemini

# ── Google Gemini Configuration (Latest Gemini 3.8 / Gemini 4 Models) ────────
# Recommended models: gemini-3.8-flash, gemini-4-hydrogen, gemini-4-argon, gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ── Ollama Configuration (Instant Fallback — set AI_PROVIDER=ollama) ─────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── Power Plant Default Capacities (MW, adjustable live in UI) ───────────────
PLANT1_CAPACITY_MW=300
PLANT2_CAPACITY_MW=300

# ── MQTT Telemetry Configuration ─────────────────────────────────────────────
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_DATA=iegms/syntaxed/grid/data
MQTT_TOPIC_SYNC=iegms/syntaxed/grid/time_sync
